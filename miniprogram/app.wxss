page {
  background: #ffffff;
  color: #202526;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 15px;
  line-height: 1.5;
  -webkit-text-size-adjust: 100%;
}
view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button {
  font: inherit;
  line-height: 1.5;
  border-radius: 4px;
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.4;
}
image {
  display: block;
}
input,
textarea {
  font: inherit;
}
button:active {
  opacity: 0.75;
}
