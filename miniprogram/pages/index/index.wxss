.app { padding: 0 24px calc(112px + env(safe-area-inset-bottom)); background: #fff; min-height: 100vh; max-width: 500px; margin: 0 auto; color: #202526; font-size: 15px; letter-spacing: 0; }
/* WeChat style v2 sizes untyped buttons with attribute selectors. */
.app button { margin: 0 !important; }
.app button.icon-button { width: 44px !important; min-width: 44px; padding: 0; }
.app button.primary,.app button.preview-button,.app button.day-summary,.app button.entry,.app button.setting-button,.app button.danger,.app .feeling-options button { width: 100% !important; }
.app button.preset,.app button.day { width: 100% !important; min-width: 0; padding-left: 0; padding-right: 0; }
.app .segments button { width: 50% !important; }
.app .bottom-nav button { width: 33.333% !important; }
.app button.text-tool,.app button.feeling-link,.app button.latest-copy,.app .choice-row button,.app .timer-line button { width: auto !important; }
.app .format-options button { width: 38px !important; }
.masthead { display: flex; align-items: center; justify-content: space-between; padding: 16px 0 10px; }
.brand { display: block; font-family: 'Songti SC','STSong','SimSun',serif; font-weight: 600; font-size: 36px; line-height: 1.1; }
.edition { display: block; margin-top: 8px; font-size: 12px; color: #63706e; }
.icon-button { width: 44px; height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.icon-button image { width: 23px; height: 23px; }
button { color: inherit; font-size: 15px; letter-spacing: 0; border-radius: 4px; }
button[disabled] { opacity: .4; background: transparent; color: inherit; }
button.primary[disabled] { background: #202526; color: #fff; opacity: .75; }
.cover-head { position: relative; z-index: 4; height: 92px; }
.cover-head .icon-button { background: rgba(255,255,255,.93); border-radius: 50%; }
.home-hero { position: relative; margin: -92px -24px 14px; overflow: hidden; }
.home-scene { position: absolute; inset: 0; width: 100%; height: 100%; }
.scene-reveal { position: absolute; left: 0; right: 0; bottom: 0; height: 100%; overflow: hidden; opacity: 0; -webkit-mask-image: linear-gradient(to bottom, transparent 45%, #000 55%); mask-image: linear-gradient(to bottom, transparent 45%, #000 55%); -webkit-mask-size: 100% 220%; mask-size: 100% 220%; -webkit-mask-position: 0 0; mask-position: 0 0; transition: opacity 1.8s ease, -webkit-mask-position 1.8s ease, mask-position 1.8s ease; }
.scene-reveal.revealing { opacity: 1; -webkit-mask-position: 0 100%; mask-position: 0 100%; }
.incoming-scene { position: absolute; bottom: 0; left: 0; width: 100%; }
.scene-breathing { animation: garden-breathe 1.8s ease-in-out; transform-origin: 70% 90%; }
.energy-reading { position: relative; z-index: 3; width: 40%; margin-left: 24px; padding-top: 98px; pointer-events: none; }
.energy-reading button { pointer-events: auto; }
.eyebrow { font-family: 'Songti SC','SimSun',serif; font-size: 17px; display: block; }
.energy-number { display: block; font-family: Georgia,'Times New Roman',serif; font-size: 82px; line-height: 1.04; font-weight: 400; white-space: nowrap; }
.energy-number.compact-number { font-size: 32px; line-height: 2.87; }
.energy-number.medium-number { font-size: 64px; line-height: 1.44; }
.estimate { font-size: 10px; color: #63706e; display: block; }
.feeling-link { text-align: left; font-size: 12px; line-height: 24px; min-height: 32px; white-space: normal; }
.feeling-link text { color: #496f9b; }
.mood-copy { display: block; margin-top: 5px; max-width: 112px; font-family: 'Songti SC','SimSun',serif; font-size: 13px; line-height: 1.5; }
.last-time { font-size: 10px; display: block; line-height: 1.5; color: #63706e; }
.segments { display: flex; border: 1px solid #202526; border-radius: 24px; padding: 2px; }
.segments button { width: 50%; height: 38px; line-height: 38px; border-radius: 22px; font-size: 17px; font-family: 'Songti SC','SimSun',serif; }
.segments .active { background: #202526; color: #fff; }
.presets { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
.preset { position: relative; min-height: 64px; padding: 7px 2px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-bottom: 1px solid #e0e5e2; font-size: 12px; line-height: 1.4; border-radius: 0; }
.preset image { width: 27px; height: 27px; }
.preset.chosen { background: #edf3ef; }
.selected-dot { width: 4px; height: 4px; background: #cf4938; position: absolute; right: 8px; top: 8px; }
.record-tools { min-height: 40px; display: flex; align-items: center; justify-content: space-between; }
.text-tool { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 12px; min-height: 40px; line-height: 1.4; }
.text-tool image { width: 18px; height: 18px; }
.primary { min-height: 46px; width: 100%; display: flex; justify-content: center; align-items: center; gap: 10px; padding: 10px 16px; background: #202526; color: #fff; font-size: 17px; line-height: 1.5; border-radius: 4px; }
.primary image { width: 21px; height: 21px; }
.latest-row { display: flex; align-items: center; padding: 15px 0; border-bottom: 1px solid #e0e5e2; }
.latest-copy { text-align: left; flex: 1; min-width: 0; line-height: 1.6; }
.small-label { display: block; font-size: 11px; color: #63706e; line-height: 1.7; }
.recent-name { display: block; font-size: 13px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.timer-line { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 12px; }
.timer-line image { width: 16px; height: 16px; }
.timer-line button { margin-left: auto; min-height: 44px; font-size: 12px; }
.month-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; margin-bottom: 10px; font-family: Georgia,serif; font-size: 28px; }
.weekdays { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); text-align: center; color: #63706e; font-size: 12px; margin-bottom: 14px; }
.calendar { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); row-gap: 6px; }
.day { height: 53px; min-width: 0; position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 5px; border-radius: 0; border: 1px solid transparent; }
.day-number { font-size: 16px; line-height: 23px; font-family: Georgia,serif; }
.day-marker { width: 26px; height: 25px; }
.day.selected { border-color: #9abdaf; border-radius: 4px; background: #f4f7f5; }
.day.outside { visibility: hidden; }
.day.future { color: #a3aba6; }
.day-number.today { color: #cf4938; }
.day-summary { display: flex; justify-content: space-between; align-items: center; text-align: left; width: 100%; margin-top: 18px; padding: 16px 0; border-top: 1px solid #d8dfdb; border-bottom: 1px solid #d8dfdb; line-height: 1.8; }
.day-summary image { width: 21px; height: 21px; }
.calendar-garden { position: relative; height: 150px; margin-top: 18px; }
.calendar-caption { position: relative; top: 38px; font-family: 'Songti SC','SimSun',serif; font-size: 21px; line-height: 1.7; z-index: 2; }
.newline { display: block; }
.calendar-art { position: absolute; right: 0; top: 0; height: 100%; width: 65%; }
.calendar-scene { width: 100%; height: 100%; }
.share-toolbar { display: flex; align-items: center; gap: 12px; margin: 12px 0; }
.date-choice { min-height: 44px; line-height: 44px; font-size: 12px; }
.format-options { margin-left: auto; display: flex; gap: 4px; }
.format-options button { width: 38px; height: 38px; display: flex; justify-content: center; align-items: center; }
.selected-format { background: #edf3ef; }
.ratio-icon { border: 1px solid #202526; }
.portrait-icon { width: 13px; height: 20px; }
.square-icon { width: 18px; height: 18px; }
.poster-wrap { position: relative; width: 100%; aspect-ratio: 600 / 1050; border-top: 1px solid #d8dfdb; border-bottom: 1px solid #d8dfdb; }
.poster-wrap.square { aspect-ratio: 1 / 1; }
.poster-image { display: block; width: 100%; animation: appear .3s ease; }
.poster-status { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 15px; color: #63706e; font-size: 13px; }
.poster-status button { text-decoration: underline; min-height: 44px; }
.poster-pagination { display: flex; align-items: center; justify-content: space-between; font-size: 12px; margin: 8px 0; }
.privacy { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0; }
.preview-button { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 6px; font-size: 14px; }
.preview-button image { width: 18px; height: 18px; }
.bottom-nav { display: flex; position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; width: 100%; max-width: 500px; margin: 0 auto; padding: 8px 20px calc(8px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid #d8dfdb; }
.bottom-nav button { width: 33.333%; min-height: 52px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 3px; font-size: 12px; opacity: .45; position: relative; }
.bottom-nav image { width: 24px; height: 24px; }
.bottom-nav .active { opacity: 1; }
.bottom-nav .active::before { content: ''; position: absolute; bottom: 0; width: 12px; height: 2px; background: #202526; }
.canvas { position: fixed; left: -2000px; top: 0; pointer-events: none; }
.overlay { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; align-items: flex-end; justify-content: center; }
.sheet-mask { position: absolute; inset: 0; background: rgba(32,37,38,.28); }
.sheet { position: relative; width: 100%; max-width: 500px; background: #fff; border-radius: 8px 8px 0 0; padding: 14px 24px 12px; overflow: hidden; }
.sheet-top { display: flex; height: 54px; flex-shrink: 0; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.sheet-title { font-size: 22px; font-family: 'Songti SC','SimSun',serif; line-height: 1.4; }
.sheet-scroll { display: block; width: 100%; overflow-y: auto; overscroll-behavior: contain; }
.sheet-note { font-size: 14px; color: #63706e; display: block; line-height: 1.8; margin: 8px 0 18px; }
.feeling-options button { width: 100%; text-align: left; border-bottom: 1px solid #d8dfdb; height: 57px; display: flex; align-items: center; justify-content: space-between; font-size: 18px; }
.feeling-options image { width: 19px; height: 19px; }
.fine-print { display: block; margin: 20px 0 8px; color: #63706e; font-size: 11px; line-height: 1.8; }
.form-section { margin: 20px 0; }
.field-label { font-size: 12px; color: #63706e; display: block; margin-bottom: 8px; }
.choice-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.choice-row button { padding: 8px 11px; min-height: 40px; border: 1px solid #d8dfdb; font-size: 13px; line-height: 1.6; }
.choice-row button.chosen { border-color: #202526; background: #edf3ef; }
.editor input, .editor textarea { box-sizing: border-box; width: 100%; border: 1px solid #c4cdc8; border-radius: 4px; font-size: 16px; color: #202526; background: #fff; }
.editor input { height: 48px; min-height: 48px; line-height: 48px; padding: 0 12px; }
.editor .title-input { height: 56px; min-height: 56px; line-height: 56px; font-size: 17px; border-color: #63706e; }
.editor textarea { height: 96px; line-height: 1.6; padding: 10px 12px; }
.date-fields { display: flex; gap: 12px; }
.date-fields picker { flex: 1; min-width: 0; border-bottom: 1px solid #d8dfdb; padding: 10px 0; min-height: 44px; font-size: 14px; }
.danger { color: #a23c31; width: 100%; min-height: 48px; font-size: 13px; margin-top: 8px; }
.entry { display: flex; gap: 12px; width: 100%; padding: 16px 0; border-bottom: 1px solid #d8dfdb; text-align: left; }
.entry > image { width: 24px; height: 24px; flex-shrink: 0; }
.entry > view { flex: 1; min-width: 0; }
.entry-label { display: block; font-size: 15px; line-height: 1.7; word-break: break-all; }
.entry .entry-arrow { width: 16px; height: 16px; }
.private-note { font-size: 12px; color: #63706e; line-height: 1.8; display: block; word-break: break-all; }
.day-detail .primary { margin-top: 20px; }
.setting-row,.setting-button { display: flex; width: 100%; justify-content: space-between; align-items: center; min-height: 58px; text-align: left; border-bottom: 1px solid #d8dfdb; font-size: 15px; }
.setting-button image { width: 18px; height: 18px; }
.restore-input { display: block; width: 100%; height: 180px; border: 1px solid #d8dfdb; padding: 12px; box-sizing: border-box; margin-bottom: 20px; font-size: 16px; line-height: 1.6; color: #202526; background: #fff; }
.error-strip { color: #a23c31; font-size: 12px; line-height: 1.7; padding: 10px 0; }
.charge .energy-number { animation: charge .65s ease-out; }
.drain .energy-number { animation: drain .65s ease-out; }
.reduced .energy-number,.reduced .poster-image,.reduced .home-scene { animation: none; }
.reduced .scene-reveal { transition: none; }
@keyframes garden-breathe { 45% { transform: scale(1.025) translateY(-3px); } 100% { transform: scale(1) translateY(0); } }
@keyframes charge { 30% { color: #cf4938; transform: translateY(-6px); } 100% { color: #202526; transform: translateY(0); } }
@keyframes drain { 30% { color: #496f9b; transform: translateY(6px); } 100% { color: #202526; transform: translateY(0); } }
@keyframes appear { from { opacity: .2; } to { opacity: 1; } }
@media (max-width: 350px) { .app { padding-left: 18px; padding-right: 18px; } .home-hero { margin-left: -18px; margin-right: -18px; } .energy-reading { margin-left: 18px; } .mood-copy { display: none; } .share-toolbar { gap: 6px; } }
